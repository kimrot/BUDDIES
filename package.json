{
  "name": "drinking-buddies",
  "version": "0.1.0",
  "private": true,
  "description": "Swipe to find a drinking buddy nearby",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "test": "node --test --test-reporter=spec tests/*.test.js",
    "dev": "DEMO=1 node --env-file-if-exists=.env --watch server.js",
    "dev:admin": "DEMO=1 ADMIN_USERS=${ADMIN:-admin} node --env-file-if-exists=.env --watch server.js",
    "db:start": "sh scripts/dev-db.sh start",
    "db:stop": "sh scripts/dev-db.sh stop",
    "db:reset": "sh scripts/dev-db.sh reset",
    "db:psql": "sh scripts/dev-db.sh psql",
    "db:migrate": "node --env-file-if-exists=.env -e \"require('./lib/db').migrate().then(()=>process.exit(0),e=>{console.error(e.message);process.exit(1)})\"",
    "db:import": "node --env-file-if-exists=.env scripts/import-json.js",
    "photos:migrate": "node --env-file-if-exists=.env scripts/migrate-photos.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1166.0",
    "@aws-sdk/s3-request-presigner": "^3.1166.0",
    "express": "^4.21.2",
    "pg": "^8.23.1",
    "redis": "^4.7.1",
    "web-push": "^3.6.7"
  }
}
