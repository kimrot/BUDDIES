# Copy to .env and fill in. `npm start` / `npm run dev` load it automatically (Node 22 --env-file).
# Real environment variables win over this file. Never commit .env.

# --- docker compose (compose.yaml) ---
# DOMAIN=buddies.example.com                   # Caddy gets an HTTPS certificate for it
# POSTGRES_PASSWORD=                           # openssl rand -hex 24
# REDIS_PASSWORD=                              # openssl rand -hex 24
# MINIO_ROOT_USER=buddies                      # only with --profile minio
# MINIO_ROOT_PASSWORD=

# --- core ---
# NODE_ENV=production
# APP_URL=https://buddies.example.com          # public https URL, used in email links
# APP_SECRET=                                  # 32+ random chars: openssl rand -base64 48
# ADMIN_USERS=yourusername
# PORT=3000
# TRUST_PROXY=1                                # only behind a reverse proxy / load balancer

# --- data (dev defaults shown) ---
# DATABASE_URL=postgres://buddies@127.0.0.1:5433/buddies
# DATABASE_SSL=1
# REDIS_URL=redis://127.0.0.1:6379
# REDIS_PREFIX=buddies:

# --- photos ---
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_FORCE_PATH_STYLE=1                         # MinIO
# PHOTO_DELIVERY=proxy                          # or redirect
# STORAGE_DRIVER=local                          # dev default when S3_BUCKET is unset

# --- verification providers ---
# AT_USERNAME=sandbox
# AT_API_KEY=
# AT_SENDER_ID=
# RESEND_API_KEY=
# EMAIL_FROM=Drinking Buddies <no-reply@example.com>
# SMILE_PARTNER_ID=
# SMILE_API_KEY=
# SMILE_ENV=sandbox

# --- push notifications ---
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# --- M-Pesa (Daraja) ---
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=174379
# MPESA_PASSKEY=
# MPESA_ENV=sandbox
# MPESA_TYPE=paybill                            # or till (+ MPESA_TILL)
# MPESA_CALLBACK_IPS=

# --- prices / limits (defaults shown) ---
# FEATURED_WEEK_KES=3000
# FEATURED_MONTH_KES=10000
# PLUS_WEEK_KES=149
# PLUS_MONTH_KES=499
# BOOST_1_KES=50
# BOOST_5_KES=200
# FREE_LIKES_PER_DAY=25
